<?php

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_image_widget().
 */
function tema_cierzo_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}


/**
 * Implements hook_theme_suggestions_page_alter().
 */
function tema_cierzo_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Obtiene el parámetro 'node' de la ruta actual, si existe.
  $current_path = \Drupal::service('path.current')->getPath();
  $path_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  if ($path_alias == '/contacto') {
     $suggestions[] = 'page__contacto';
  }

  // Login y «he olvidado mi contraseña» comparten la misma página-tarjeta.
  $ruta = \Drupal::routeMatch()->getRouteName();
  if (in_array($ruta, ['user.login', 'user.pass'], TRUE)) {
    $suggestions[] = 'page__user__login';
  }

}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * 'es_portada' para no duplicar el H1 en la home (lo pone el vídeo).
 * Es constante por nodo (solo un nodo es la portada), así que no rompe la caché.
 */
function tema_cierzo_preprocess_node(array &$variables) {
  $variables['es_portada'] = \Drupal::service('path.matcher')->isFrontPage();
}

/**
 * Implements hook_preprocess_HOOK() for paragraph templates.
 *
 * El titular del vídeo de cabecera solo es H1 en la portada; en otras páginas
 * el H1 es el título de la página.
 */
function tema_cierzo_preprocess_paragraph(array &$variables) {
  $variables['es_portada'] = \Drupal::service('path.matcher')->isFrontPage();
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function tema_cierzo_preprocess_page(array &$variables) {
  // La plantilla de login la usan /user/login y /user/password.
  $variables['ruta_usuario'] = \Drupal::routeMatch()->getRouteName();
}
