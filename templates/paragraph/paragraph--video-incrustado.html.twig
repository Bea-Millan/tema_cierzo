{# themes/tu_tema/templates/paragraph/paragraph--video-incrustado.html.twig #}
{{ attach_library('tema_cierzo/video-full-width-section') }}

<div{{ attributes.addClass('paragraph', 'paragraph--type--video-incrustado', 'paragraph--full-width-video') }}>
  {{ content }}


 {# --- NUEVA CAPA DE CONTENIDO SUPERPUESTO --- #}
  <div class="video-overlay-content">
    {# h1 de la portada (SEO). Spans en vez de <p>: un <p> no puede ir dentro de un encabezado #}
    {% set etiqueta_titular = es_portada ? 'h1' : 'h2' %}
    <{{ etiqueta_titular }} class="overlay-title">
      <span class="interactive__label">Música</span>
      <span class="interactive__word">EMOCIÓN</span>
      <span class="interactive__label">Crecimiento</span>
    </{{ etiqueta_titular }}>

    {# <p class="overlay-text">Descubre cómo el Método Suzuki puede transformar la vida de tu hijo a través de la música.</p> #}
    <a href="/conocer-el-metodo-suzuki" class="button overlay-button">Saber Más</a>
    <a href="/conocer-el-metodo-suzuki" class="overlay-link-mobile">Ver más -&gt;</a>
  </div>
  {# --- FIN DE LA NUEVA CAPA --- #}

  <button class="video-control-button is-playing" aria-label="Pausar vídeo">
    <span class="play-icon"></span>
    <span class="pause-icon"></span>
  </button>
</div>
