{# Filas del listado del blog: tarjetas en masonry.
   El título y la entradilla los pinta views-view--blog--page.html.twig #}
<div id="masonry-container">
{% for row in rows %}
  <div class="masonry-item">
    <article class="card">
      {{- row.content -}}
    </article>
  </div>
{% endfor %}
</div>
