{#
/**
 * @file
 * Cada concierto (Elemento de Itinerario) en la línea de tiempo.
 *
 * Debajo del texto salen hasta dos enlaces, solo si tienen sentido:
 * - «Más información»: si el concierto tiene contenido propio en su página
 *   (texto largo/repertorio en el cuerpo o fotos en la Galería).
 * - «Lee la crónica»: si tiene algo en el campo Enlace (normalmente la
 *   entrada del blog). El texto del enlace se puede cambiar en el campo.
 * Si no tiene ninguna de las dos cosas, la tarjeta no enlaza a nada.
 */
#}
{% set hito = row._entity %}
{% set tiene_pagina = (hito.body.value|striptags|trim is not empty)
  or (hito.hasField('field_galeria') and not hito.field_galeria.isEmpty()) %}
{% set tiene_enlace = hito.hasField('field_enlace') and not hito.field_enlace.isEmpty() %}
{% set url_hito = path('entity.node.canonical', {'node': hito.id}) %}

<div class="timeline-item" data-aos="fade-up">

  <div class="timeline-date">
    {% if fields.field_ano.content|render|trim %}
      {{ fields.field_ano.content }}
    {% else %}
      {{ fields.field_fecha.content }}
    {% endif %}
  </div>

  <div class="timeline-dot"></div>

  <div class="timeline-content">
    {% if fields.field_imagen.content %}
      <div class="timeline-image">
        {% if tiene_pagina %}
          <a href="{{ url_hito }}" tabindex="-1" aria-hidden="true">{{ fields.field_imagen.content }}</a>
        {% else %}
          {{ fields.field_imagen.content }}
        {% endif %}
      </div>
    {% endif %}

    <div class="timeline-text">
      <h3 class="timeline-title">
        {% if tiene_pagina %}
          <a href="{{ url_hito }}">{{ hito.label }}</a>
        {% else %}
          {{ hito.label }}
        {% endif %}
      </h3>

      <div class="timeline-body">
        {{ fields.field_texto_corto.content }}
      </div>

      {% if tiene_pagina or tiene_enlace %}
        <div class="timeline-acciones">
          {% if tiene_pagina %}
            <a href="{{ url_hito }}" class="timeline-accion">Más información <span aria-hidden="true">→</span></a>
          {% endif %}
          {% if tiene_enlace %}
            <a href="{{ hito.field_enlace.0.url.toString() }}" class="timeline-accion timeline-accion--blog">{{ hito.field_enlace.title ?: 'Lee la crónica' }} <span aria-hidden="true">→</span></a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

</div>
