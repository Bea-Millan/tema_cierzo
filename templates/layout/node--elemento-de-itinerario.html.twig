{#
/**
 * @file
 * Página de un hito del itinerario (p. ej. cada concierto de carnaval).
 *
 * Reutiliza el maquetado de la banda imagen-texto en su variante clara
 * (.prgph-wrapper.estilo-oscuro) para que encaje con el resto de la web.
 * Campos: field_imagen (multimedia de tipo imagen), field_categoria,
 * field_ano, field_texto_corto, body y field_enlace.
 */
#}
{# field_imagen es una referencia a Multimedia: el archivo está en su field_media_image #}
{% set media = node.field_imagen.entity ?? null %}
{% set imagen = media and media.hasField('field_media_image') ? media.field_media_image.entity : null %}
{% set imagen_alt = media and media.hasField('field_media_image') ? media.field_media_image.alt : '' %}

{# Categoría (vocabulario Itinerarios) #}
{% set categoria = '' %}
{% if node.field_categoria.entity %}
  {% set categoria = node.field_categoria.entity.label %}
{% endif %}

{% set ano = node.hasField('field_ano') ? node.field_ano.value : '' %}
{% set etiqueta = [categoria, ano]|filter(v => v)|join(' · ') %}

{# Botón de vuelta a la línea de tiempo de su categoría.
   Al crear una categoría nueva en Itinerarios, añadir aquí su página. #}
{% set paginas_itinerario = {
  'Carnaval': '/conciertos-de-carnaval',
  'Santa Cecilia': '/conciertos-de-santa-cecilia',
  'Curso de verano': '/curso-de-verano',
} %}
{% set volver_url = paginas_itinerario[categoria] ?? '/conciertos-de-carnaval' %}

<article{{ attributes.addClass('node', 'node--type-elemento-de-itinerario') }}>
  <main class="site-content">
    <a id="main-content" tabindex="-1"></a>

    <div class="prgph-wrapper estilo-oscuro salida-imagen-none estilo-boton-ligero" style="--estilo-oscuro-bg: #ebe8e3;">
      <div class="inner-banda-premium">
        <div class="prgph texto-imagen posicion-izquierda">

          {% if imagen %}
            <div class="col-imagen field-imagen">
              <div class="imagen-overlap">
                <img src="{{ file_url(imagen.uri.value) }}" alt="{{ imagen_alt ?: node.label }}" />
              </div>
            </div>
          {% endif %}

          <div class="texto-parrafo">
            {% if etiqueta %}
              <p class="texto-etiqueta">{{ etiqueta }}</p>
            {% endif %}

            {{ title_prefix }}
            <h1 class="titulo-encima-texto">{{ label }}</h1>
            {{ title_suffix }}

            {% if node.field_texto_corto.value or node.body.value %}
              <div class="cuerpo-texto">
                {% if node.field_texto_corto.value %}
                  {{ node.field_texto_corto.value|check_markup(node.field_texto_corto.format) }}
                {% endif %}
                {% if node.body.value %}
                  {{ node.body.value|check_markup(node.body.format) }}
                {% endif %}
              </div>
            {% endif %}

            <div class="boton-wrapper">
              {% if node.field_enlace.uri %}
                <a href="{{ node.field_enlace.0.url }}">{{ node.field_enlace.title ?: 'Ver más' }}</a>
              {% endif %}
              <a href="{{ volver_url }}" class="boton-volver">Ver todos los conciertos</a>
            </div>
          </div>

        </div>
      </div>
    </div>

    {# Galería de fotos del concierto (campo multimedia múltiple field_galeria).
       Usa la plantilla field--field-galeria.html.twig, con lightbox. #}
    {% if node.hasField('field_galeria') and not node.field_galeria.isEmpty() %}
      <section class="itinerario-galeria">
        <h2 class="itinerario-galeria__titulo">Galería</h2>
        {{ content.field_galeria }}
      </section>
    {% endif %}

  </main>
</article>
